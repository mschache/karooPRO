<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets adb fire test alerts without bringing an activity to the front. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <receiver
            android:name=".DebugReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="io.github.mschache.karoopro.debug.ALERT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
