<?xml version="1.0" encoding="utf-8"?>
<!--
    One painted image plus invisible tap zones. Weights match HERO_FRACTION (0.52) in FieldPainter.
    The image is clipped to the rounded box the Karoo draws around every field (Android 12+).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/field_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/field_outline"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        tools:targetApi="31" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/tap_hero"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="52" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="48"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/tap_previous"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/tap_middle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/tap_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
