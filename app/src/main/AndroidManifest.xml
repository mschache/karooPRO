<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Coach panel: read and confirm messages from the Karoo Coach extension, when it's installed. -->
    <uses-permission android:name="io.github.mschache.karoocoach.permission.COACH" />

    <queries>
        <package android:name="io.github.mschache.karoocoach" />
    </queries>

    <application
        android:name=".KarooProApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KarooPro">

        <!-- Lets the Karoo check GitHub releases for updates -->
        <meta-data
            android:name="io.hammerhead.karooext.MANIFEST_URL"
            android:value="${manifestUrl}" />

        <activity
            android:name=".ui.settings.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ui.field.FieldActionReceiver"
            android:exported="false" />

        <service
            android:name=".KarooProExtension"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>
    </application>

</manifest>
